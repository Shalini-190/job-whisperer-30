{
  "manifest_version": 3,
  "name": "JobWhisperer AI Autofill",
  "version": "1.0.2",
  "description": "Automatically fills job application forms using your JobWhisperer AI profile",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobWhisperer AI Autofill"
  }
}